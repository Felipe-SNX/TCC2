.tela-loading {
    flex-grow: 1;
    background-color: #1A212E;
    justify-content: center;
    align-items: center;
}

.container-central {
    align-items: center;
    width: 60%;
}

.texto-loading {
    font-size: 70px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 20px;
    letter-spacing: 10px;
}

.barra-fundo {
    width: 100%;
    height: 50px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    border-width: 4px;
    border-color: #3C4B64;
    overflow: hidden; 
}

.barra-preenchimento {
    height: 100%;
    width: 0%; 
    background-color: #FFD700;
    border-radius: 15px;
    transition-duration: 0.1s;
}

.texto-porcentagem {
    font-size: 60px;
    color: #FFD700;
    margin-top: 10px;
    -unity-font-style: bold;
}