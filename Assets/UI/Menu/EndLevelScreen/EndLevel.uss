.tela-cheia {
    width: 100%;
    height: 100%;
    align-items: center; 
    justify-content: center; 
    background-color: rgba(0, 0, 0, 0.75); 
}

.banner-anuncio {
    align-items: center; 
    padding: 50px 80px;
    background-color: rgba(30, 40, 50, 0.95); 
    border-radius: 20px; 
    width: 850px; 
    max-height: 90%;
    border-width: 4px;
    border-color: #4A5A6A;
}

.titulo {
    font-size: 70px; 
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center; 
    margin-bottom: 40px; 
    text-shadow: 4px 4px 0px rgba(0, 0, 0, 0.5);
}

.texto-fase {
    font-size: 35px; 
    color: #A0C0D0;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 20px; 
    text-shadow: 3px 3px 0px rgba(0, 0, 0, 0.8);
    white-space: normal; 
}

.container-botoes {
    width: 100%;
    align-items: center;
    margin-top: 30px;
}

.botao {
    width: 450px; 
    font-size: 30px;
    color: black;
    background-color: #FDF9EB;
    padding: 15px 20px;
    margin-bottom: 20px; 
    border-radius: 8px;
    border-left-width: 8px;
    border-bottom-width: 6px;
    border-top-width: 0;
    border-right-width: 0;
    border-color: #D6D0B9;
    -unity-font-style: bold;
    -unity-text-align: middle-center; 
    transition-duration: 0.15s;
}

.botao:hover {
    background-color: #FFFFFF;
    scale: 1.05;
}