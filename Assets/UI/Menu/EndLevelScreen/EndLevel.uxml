<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd"
>
    <Style src="EndLevel.uss" />

    <ui:VisualElement class="tela-cheia">
        
        <ui:VisualElement class="banner-anuncio">
            
            <ui:Label name="txt-nome-fase" text="Nome da Fase" class="titulo" />
            
            <ui:Label name="txt-tempo-total" text="Tempo Total: 00:00" class="texto-fase" />
            <ui:Label name="txt-tentativas" text="Número de Tentativas: 0" class="texto-fase" />
            <ui:Label name="txt-coletaveis" text="Número de Coletáveis obtidos: 0" class="texto-fase" />
            
            <ui:VisualElement class="container-botoes">
                <ui:Button name="btn-reset" text="Reiniciar Fase" class="botao" />
                <ui:Button name="btn-voltar-menu" text="Voltar a seleção de fase" class="botao" />
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>