.tela-cheia { width: 100%; height: 100%; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.7); }

.painel-vidro {
    background-color: rgba(15, 23, 42, 0.95);
    border-radius: 30px;
    border-width: 2px;
    border-color: rgba(0, 255, 255, 0.3);
    padding: 50px 80px;
    width: 850px;
    align-items: center;
}

.titulo-container { position: relative; height: 90px; margin-bottom: 20px; }
.titulo { font-size: 60px; -unity-font-style: bold; margin: 0; white-space: nowrap; }
.titulo-cinza { color: #444444; }
.mascara { position: absolute; top: 0; left: 0; bottom: 0; width: 0%; overflow: hidden; }
.colorido { color: #00FFFF; position: absolute; left: 0; top: 0; text-shadow: 0px 0px 15px rgba(0, 255, 255, 0.5); }


.label-input { font-size: 22px; color: #FDF9EB; -unity-font-style: bold; margin-top: 15px; }

.custom-input {
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 8px; border-width: 2px; border-color: #556677;
    color: white; font-size: 25px; height: 50px; width: 100%;
}

.container-botoes { width: 100%; align-items: center; margin-top: 30px; }

.botao-menu {
    align-self: center; margin-bottom: 20px;
    background-color: transparent; border-width: 0; padding: 0;
    position: relative;
}
.texto-botao { font-size: 35px; color: #888888; -unity-font-style: bold; padding-bottom: 5px; transition-duration: 0.2s; }

.linha-inferior {
    position: absolute; bottom: -5px; left: 0; right: 0; height: 6px; 
    background-color: #FF3333; scale: 0 1; transform-origin: center;
    transition-property: scale; transition-duration: 0.2s;
}

.botao-menu:hover .texto-botao, .botao-menu:focus .texto-botao { color: #FFFFFF; }
.botao-menu:hover .linha-inferior, .botao-menu:focus .linha-inferior { scale: 1 1; }