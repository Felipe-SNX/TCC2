.tela-cheia {
    width: 100%;
    height: 100%;
    align-items: center; 
    justify-content: center; 
    background-color: rgba(0, 0, 0, 0.75); 
}

.banner-anuncio {
    align-items: center; 
    padding: 50px 80px;
    background-color: rgba(30, 40, 50, 0.95); 
    border-radius: 20px; 
    width: 850px; 
    max-height: 90%; 
    border-width: 4px;
    border-color: #4A5A6A;
}

.titulo {
    font-size: 70px; 
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center; 
    margin-bottom: 20px; 
    text-shadow: 4px 4px 0px rgba(0, 0, 0, 0.5);
}

.texto-fase {
    font-size: 35px;
    color: #A0C0D0;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal; 
}

.label-input {
    font-size: 25px;
    color: #FDF9EB;
    -unity-font-style: bold;
    margin-bottom: 5px;
    margin-top: 15px;
}

.input-group {
    width: 100%;
    align-items: flex-start;
}

.custom-input {
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 8px;
    border-width: 2px;
    border-color: #A0C0D0;
    color: white;
    font-size: 25px;
    height: 55px; 
    width: 100%;
    padding: 0 10px;
}

.custom-input .unity-base-text-field__input {
    background-color: transparent;
    border-width: 0;
    color: white;
}

.erro-texto {
    color: #FF5555;
    font-size: 18px;
    -unity-font-style: bold;
    display: none;
    margin-top: 5px;
}

.question-group {
    margin-top: 40px;
    margin-bottom: 20px;
    width: 100%;
    align-items: center;
}

.slider-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 90%;
    margin-top: 20px;
}

.custom-slider {
    flex-grow: 1;
    margin-right: 20px;
}

.custom-slider .unity-base-slider__tracker {
    background-color: #1A242D;
    height: 12px;
    border-radius: 6px;
    border-width: 2px;
    border-color: #0F151A;
}

.custom-slider .unity-base-slider__dragger {
    background-color: #FDF9EB;
    width: 35px;
    height: 35px;
    border-radius: 20px;
    border-width: 4px;
    border-color: #A0C0D0;
    margin-top: -11px; 
    transition-duration: 0.1s;
}

.custom-slider .unity-base-slider__dragger:hover {
    scale: 1.2;
    background-color: #FFFFFF;
}

.slider-value-right {
    color: #FDF9EB;
    font-size: 55px;
    -unity-font-style: bold;
    text-shadow: 3px 3px 0px rgba(0, 0, 0, 0.8);
    width: 60px;
    -unity-text-align: middle-right;
}

.botao {
    width: 400px; 
    font-size: 30px;
    color: black;
    background-color: #FDF9EB;
    padding: 15px 20px;
    margin-top: 30px; 
    border-radius: 8px;
    border-left-width: 8px;
    border-bottom-width: 6px;
    border-top-width: 0;
    border-right-width: 0;
    border-color: #D6D0B9;
    -unity-font-style: bold;
    -unity-text-align: middle-center; 
    transition-duration: 0.15s;
}

.botao:hover {
    background-color: #FFFFFF;
    scale: 1.05;
}

.escala-legendas {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    padding-right: 80px; 
    margin-top: 5px;
}

.legenda-texto {
    color: #D6D0B9;
    font-size: 20px;
    -unity-font-style: italic;
    text-shadow: 2px 2px 0px rgba(0, 0, 0, 0.8);
}