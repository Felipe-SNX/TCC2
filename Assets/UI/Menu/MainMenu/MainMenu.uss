.tela-inteira {
    flex-grow: 1;
    padding: 120px; 
}

.titulo-jogo {
    font-size: 110px; 
    color: white;
    -unity-font-style: bold;
    margin-bottom: 200px; 
    text-shadow: 4px 4px 0px rgba(0, 0, 0, 0.5); 
}

.area-central {
    flex-direction: row;
    flex-grow: 1;
    align-items: flex-start; 
}

.container-botoes {
    width: 450px; 
}

.botao-menu {
    font-size: 45px; 
    color: black;
    background-color: #FDF9EB; 
    padding: 20px 30px; 
    margin-bottom: 24px; 
    border-radius: 24px;
    border-left-width: 12px;
    border-bottom-width: 8px;
    border-top-width: 0;
    border-right-width: 0;
    border-color: #D6D0B9; 
    
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-duration: 0.15s;
}

.botao-menu:hover,
.botao-menu:focus {
    background-color: #FFFFFF;
    translate: 10px 0; 
}

.painel {
    flex-grow: 1; 
}

.painel-escondido {
    display: none; 
}