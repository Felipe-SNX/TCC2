* {
    margin: 0;
    padding: 0;
}

.tela-cheia { 
    position: absolute; 
    top: 0;
    left: 0;
    width: 100%; 
    height: 100%; 
    align-items: center; 
    justify-content: center; 
    background-color: rgba(0, 0, 0, 0.7); 
}

.painel-vidro {
    background-color: rgba(15, 23, 42, 0.95);
    border-radius: 30px;
    padding: 50px 80px;
    width: 1200px; 
    max-height: 90%;
    align-items: center;
}

.hidden {
    display: none;
}

.titulo-container { 
    position: relative; 
    height: 90px; 
    margin-bottom: 20px; 
}

.titulo { 
    font-size: 100px; 
    -unity-font-style: bold; 
    margin: 0; 
    white-space: nowrap; 
}

.titulo-cinza { color: #444444; }

.mascara { 
    position: absolute; 
    top: 0; left: 0; bottom: 0; width: 0%; 
    overflow: hidden; 
}

.colorido { 
    color: rgba(0, 255, 102, 1); 
    position: absolute; 
    left: 0; top: 0; 
    text-shadow: 0px 0px 15px rgba(0, 255, 102, 0.5); 
}

.desc-fase { 
    font-size: 50px; 
    color: #D6D0B9; 
    margin-bottom: 30px; 
    -unity-text-align: middle-center; 
}

.input-group { 
    width: 100%; 
    align-items: stretch; 
    margin-bottom: 25px;
}

.label-input { 
    font-size: 40px; 
    color: #FDF9EB; 
    -unity-font-style: bold; 
    margin-top: 15px; 
    margin-bottom: 5px; 
}

.custom-input {
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 8px; 
    border-width: 2px;
    border-color: #556677;
    color: black; 
    font-size: 40px; 
    height: 50px; 
    width: 100%; 
}

.erro-texto { 
    color: #FF5555; 
    font-size: 32px; 
    -unity-font-style: bold; 
    display: none; 
    margin-top: 5px; 
}

.manual-toggle-text {
    white-space: normal; 
    color: #FDF9EB; 
    font-size: 24px;
    flex-grow: 1; 
    flex-shrink: 1;
    -unity-font-style: normal; 
    margin-left: 15px;
}

.custom-checkbox {
    margin-right: 15px;
    flex-shrink: 0; 
}

.custom-checkbox .unity-toggle__checkmark {
    width: 45px;     
    height: 45px;    
    border-radius: 8px; 
    border-width: 2px;
    border-color: #556677;
    background-color: rgba(0, 0, 0, 0.4);
}

.custom-checkbox .unity-toggle__input:checked > .unity-toggle__checkmark {
    background-color: rgba(0, 255, 102, 1);
    border-color: #FFFFFF;
}

.manual-toggle-container {
    flex-direction: row;
    width: 100%;
    align-items: center; 
    margin-top: 15px;
    margin-bottom: 30px;
}

.container-botoes { 
    width: 100%; 
    align-items: center; 
    margin-top: 40px; 
}

.botao-menu {
    background-color: transparent; 
    border-width: 0; 
    padding: 10px 20px;
    position: relative;
}

.texto-botao { 
    font-size: 50px; 
    color: #888888; 
    -unity-font-style: bold; 
    transition-duration: 0.2s;
}

.linha-inferior {
    position: absolute; 
    bottom: -5px; 
    left: 0; 
    right: 0; 
    height: 6px; 
    background-color: #FF3333; 
    transform-origin: center;
    scale: 0 1; 
    transition-property: scale; 
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.botao-menu:hover .linha-inferior {
    scale: 1 1; 
}

.botao-menu:hover .texto-botao {
    color: #FFFFFF;
}