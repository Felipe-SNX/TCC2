.tela-cheia {
    width: 100%;
    height: 100%;
    align-items: center; 
    justify-content: center; 
    background-color: rgba(0, 0, 0, 0.6); 
}

.banner-anuncio {
    align-items: center; 
    padding: 60px 100px;
    background-color: rgba(30, 40, 50, 0.9); 
    border-radius: 20px; 
}

.titulo {
    font-size: 110px; 
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center; 
    margin-bottom: 60px; 
    text-shadow: 4px 4px 0px rgba(0, 0, 0, 0.5);
}

.texto-fase {
    font-size: 60px;
    color: #A0C0D0;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 25px; 
    text-shadow: 3px 3px 0px rgba(0, 0, 0, 0.8);
}

.botao {
    width: 550px; 
    font-size: 35px;
    color: black;
    background-color: #FDF9EB;
    padding: 15px 20px;
    margin-top: 20px; 
    margin-bottom: 15px; 
    border-radius: 8px;
    border-left-width: 8px;
    border-bottom-width: 6px;
    border-top-width: 0;
    border-right-width: 0;
    border-color: #D6D0B9;
    -unity-font-style: bold;
    -unity-text-align: middle-center; 
    transition-duration: 0.15s;
}

.botao:hover {
    background-color: #FFFFFF;
    scale: 1.05;
}