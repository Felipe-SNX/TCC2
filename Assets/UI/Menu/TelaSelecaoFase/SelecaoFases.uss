.tela-inteira {
    flex-grow: 1;
    padding: 60px;
    align-items: center; 
    background-color: rgba(0, 0, 0, 0.8); 
}

.titulo-tela {
    font-size: 80px;
    color: white;
    -unity-font-style: bold;
    margin-top: 20px;
    text-shadow: 4px 4px 0px rgba(0, 0, 0, 0.6);
}

.carrossel-fases {
    flex-grow: 1; 
    width: 100%;  
    margin-top: 50px;    
    margin-bottom: 30px; 
}

.bandeja-fases {
    flex-direction: row;      
    align-items: center;      
    height: 100%;             
    padding-left: 100px;  
    padding-right: 100px; 
}

.cartao-fase {
    width: 480px;        
    height: 85%;         
    margin: 0 40px;      
    border-radius: 35px; 
    border-width: 0;
    background-color: #555555;
    transition-property: scale, translate, background-color;
    transition-duration: 0.2s, 0.2s, 0.3s;
    flex-shrink: 0; 
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    background-image: none; 
    padding-top: 0;
    padding-left: 0;
    padding-right: 0;
    padding-bottom: 20px;
}

.cartao-fase:hover,
.cartao-fase:focus {
    scale: 1.05; 
    translate: 0 -20px; 
}

.frente-cartao {
    width: 100%;
    height: 100%;
    background-color: #808080; 
    border-radius: 35px; 
    border-width: 0;
    overflow: hidden; 
    position: relative;
    justify-content: flex-end; 
    padding-bottom: 60px; 
}

.texto-fase {
    position: relative;
    font-size: 65px; 
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal; 
    text-shadow: 4px 4px 0px rgba(0, 0, 0, 0.4); 
}

.cor-preenchimento { 
    position: absolute;
    bottom: 0; 
    left: 0;
    width: 100%;
    height: 0%;
    transition-property: height;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.cartao-fase:hover .cor-preenchimento {
    height: 100%;
}
.cartao-fase:focus .cor-preenchimento {
    height: 100%;
}

.tema-verde .cor-preenchimento { background-color: #4CAF50; }
.tema-verde:hover, .tema-verde:focus { background-color: #2E7D32; }

.tema-vermelho .cor-preenchimento { background-color: #F44336; }
.tema-vermelho:hover, .tema-vermelho:focus { background-color: #C62828; }

.tema-amarelo .cor-preenchimento { background-color: #FFC107; }
.tema-amarelo:hover, .tema-amarelo:focus { background-color: #FFC40C; }

.botao-voltar {
    align-self: flex-start; 
    font-size: 50px;
    padding: 25px 80px;    
    margin-left: 50px;      
    margin-bottom: 30px;
    color: black;
    background-color: #FDF9EB;
    padding: 15px 50px;
    border-radius: 8px;
    border-left-width: 8px;
    border-bottom-width: 6px;
    border-top-width: 0;
    border-right-width: 0;
    border-color: #D6D0B9;
    -unity-font-style: bold;
    transition-duration: 0.15s;
}

.botao-voltar:hover,
.botao-voltar:focus {
    background-color: #FFFFFF;
    scale: 1.05;
}