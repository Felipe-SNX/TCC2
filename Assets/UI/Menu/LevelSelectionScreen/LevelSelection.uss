.tela-inteira {
    flex-grow: 1;
    padding: 60px;
    align-items: center; 
    background-color: transparent; 
}

.titulo-container { 
    position: relative; 
    height: 100px; 
    margin-bottom: 20px; 
    align-self: center; 
}
.titulo-tela { 
    font-size: 100px; 
    -unity-font-style: bold; 
    margin: 0; 
    padding: 0; 
    white-space: nowrap; 
    -unity-text-align: middle-center; 
}
.titulo-cinza { color: #444444; }
.mascara { position: absolute; top: 0; left: 0; bottom: 0; width: 0%; overflow: hidden; }
.colorido { color: rgba(0, 255, 102, 1); position: absolute; left: 0; top: 0; }

.carrossel-fases {
    flex-grow: 1; 
    width: 100%;  
    margin-top: 50px;    
    margin-bottom: 30px; 
}

.bandeja-fases {
    flex-direction: row;      
    align-items: center;      
    height: 100%;             
    padding-left: 100px;  
    padding-right: 100px; 
}

.cartao-fase {
    width: 450px; 
    height: 85%;         
    margin: 0 40px;      
    border-radius: 35px; 
    border-width: 3px; 
    
    background-color: rgba(15, 23, 42, 0.7); 
    transition-property: scale, translate, border-color;
    transition-duration: 0.2s, 0.2s, 0.3s;
    flex-shrink: 0; 
    padding: 0; 
}

.cartao-fase:hover,
.cartao-fase:focus {
    scale: 1.05; 
    translate: 0 -20px; 
}

.frente-cartao {
    width: 100%;
    height: 100%;
    background-color: transparent; 
    border-radius: 32px; 
    border-width: 0;
    overflow: hidden; 
    position: relative;
    justify-content: flex-end; 
    padding-bottom: 60px; 
}

.texto-fase {
    position: relative;
    font-size: 80px; 
    color: #888888; 
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal; 
    transition-duration: 0.3s;
}

.cartao-fase:hover .texto-fase,
.cartao-fase:focus .texto-fase {
    color: #FFFFFF; 
    text-shadow: 0px 0px 15px rgba(255, 255, 255, 0.5); 
}

.cor-preenchimento { 
    position: absolute;
    bottom: 0; 
    left: 0;
    width: 100%;
    height: 0%;
    transition-property: height;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.cartao-fase:hover .cor-preenchimento,
.cartao-fase:focus .cor-preenchimento {
    height: 100%;
}

/* Verde */
.tema-verde { border-color: rgba(50, 205, 50, 0.2); }
.tema-verde:hover, .tema-verde:focus { border-color: rgba(50, 205, 50, 1); }
.tema-verde .cor-preenchimento { background-color: rgba(50, 205, 50, 0.3); } 

/* Vermelho */
.tema-vermelho { border-color: rgba(255, 51, 51, 0.2); }
.tema-vermelho:hover, .tema-vermelho:focus { border-color: rgba(255, 51, 51, 1); }
.tema-vermelho .cor-preenchimento { background-color: rgba(255, 51, 51, 0.3); }

/* Amarelo */
.tema-amarelo { border-color: rgba(255, 215, 0, 0.2); }
.tema-amarelo:hover, .tema-amarelo:focus { border-color: rgba(255, 215, 0, 1); }
.tema-amarelo .cor-preenchimento { background-color: rgba(255, 215, 0, 0.3); }

.botao-menu {
    align-self: flex-start;
    margin-left: 50px;
    margin-bottom: 30px;
    background-color: transparent;
    border-width: 0;
    padding: 0;
    position: relative; 
}

.texto-botao {
    font-size: 65px; 
    color: #888888;
    -unity-font-style: bold;
    padding-bottom: 5px;
    transition-duration: 0.2s;
}

.linha-inferior {
    position: absolute;
    bottom: -5px;      
    left: 0;  
    right: 0;         
    height: 6px;
    scale: 0 1;
    background-color: #FF3333;
    transform-origin: left;
    transition-property: scale, translate; 
    transition-duration: 0.2s, 0.2s;
}

.botao-menu:hover .texto-botao,
.botao-menu:focus .texto-botao {
    color: #FFFFFF;
    translate: 10px 0;
}

.botao-menu:hover .linha-inferior,
.botao-menu:focus .linha-inferior {
    scale: 1 1;
    translate: 10px 0;
}