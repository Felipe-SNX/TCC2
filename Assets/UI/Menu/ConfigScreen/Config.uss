.tela-inteira {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: transparent;
}

.titulo-container { 
    position: relative; 
    align-self: center; 
    margin-bottom: 30px; 
}

.titulo-tela { 
    font-size: 100px; 
    -unity-font-style: bold; 
    margin: 0; 
    padding: 0; 
    white-space: nowrap; 
}

.titulo-cinza { 
    color: #333333; 
}

.mascara { 
    position: absolute; 
    top: 0; 
    left: 0; 
    bottom: 0; 
    width: 0%; 
    overflow: hidden; 
}

.colorido { 
    color: rgba(0, 255, 102, 1); 
    position: absolute; 
    top: 0; 
    left: 0; 
}

.painel-vidro {
    width: 75%;
    height: 70%;
    background-color: rgba(15, 23, 42, 0.85); 
    border-radius: 20px;
    border-width: 1px;
    border-color: rgba(0, 255, 255, 0.2); 
    overflow: hidden;
}

.layout-duas-colunas { 
    flex-direction: row; 
    flex-grow: 1; 
}

.sidebar { 
    width: 30%; 
    background-color: rgba(0, 0, 0, 0.4); 
    padding: 30px; 
    display: flex; 
    flex-direction: column; 
}

.botao-menu {
    background-color: transparent;
    border-width: 0; 
    padding: 0; 
    margin-bottom: 20px; 
    align-items: flex-start;
    flex-shrink: 0; 
    overflow: visible;
    position: relative;
}

.texto-botao { 
    font-size: 60px; 
    color: #888888; 
    -unity-font-style: bold; 
    padding-bottom: 5px; 
    transition-duration: 0.2s; 
}

.linha-inferior { 
    position: absolute; 
    bottom: -8px;       
    left: 0;
    height: 4px; 
    width: 0%; 
    background-color: white; 
    transition-property: width; 
    transition-duration: 0.2s;
}

.botao-menu:hover .texto-botao, .aba-ativa .texto-botao { 
    color: #FFFFFF; 
    translate: 10px 0; 
}

.botao-menu:hover .linha-inferior, .aba-ativa .linha-inferior { 
    background-color: #FF3333; 
    width: 100%; 
    translate: 10px 0; 
}

.painel-conteudo { 
    width: 70%; 
    padding: 40px; 
    display: flex; 
    flex-direction: column; 
}

.titulo-aba { 
    font-size: 50px; 
    color: white; 
    -unity-font-style: bold; 
    margin-bottom: 30px; 
    border-bottom-width: 2px; 
    border-color: rgba(255, 255, 255, 0.1); 
    padding-bottom: 10px;
}

.aba-container { 
    flex-grow: 1; 
    display: flex; 
    flex-direction: column; 
}

.oculta {
    display: none;
}

.linha-slider { 
    flex-direction: row; 
    align-items: center; 
    margin-bottom: 25px; 
}

.labels { 
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/alagard.ttf");
    font-size: 28px; 
    color: #CCCCCC; 
    width: 280px;
    padding-right: 30px; 
    -unity-font-style: bold; 
}

.valor-slider { 
    font-size: 28px; 
    color: white; 
    width: 60px; 
    -unity-text-align: middle-right; 
    -unity-font-style: bold; 
}

.meu-slider { 
    flex-grow: 1; 
    margin-right: 20px; 
}

.meu-slider #unity-tracker { 
    background-color: #1e293b; 
    border-radius: 5px; 
    border-width: 0; 
    height: 10px; 
    margin-top: -5px; 
}

.meu-slider #unity-dragger { 
    background-color: white; 
    border-radius: 10px; 
    width: 20px; 
    height: 20px; 
    border-width: 0; 
    margin-top: -10px;
}

.meu-slider-rastro {
    height: 100%;
    border-radius: 5px;
}

.linha-graficos { 
    flex-direction: row; 
    align-items: center;
    margin-bottom: 25px; 
}

.dropdown-neon { 
    flex-grow: 1;
}

.dropdown-neon > .unity-base-field__input {
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: #555555; 
    border-radius: 0;
    padding: 5px 0;
}

.dropdown-neon .unity-base-popup-field__text-element,
.dropdown-neon .unity-popup-field__text,
.dropdown-neon .unity-text-element {
    color: #FFFFFF !important; 
    font-size: 24px;
    -unity-font-style: bold;
    padding-left: 5px;
}

.dropdown-neon .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: #888888;
    transition-duration: 0.15s;
}

.dropdown-neon:hover > .unity-base-field__input,
.dropdown-neon:focus > .unity-base-field__input {
    border-bottom-color: #FF3333; 
}

.dropdown-neon:hover .unity-base-popup-field__arrow,
.dropdown-neon:focus .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: #FF3333; 
}

.botao-reset {
    background-color: transparent; 
    border-width: 2px; 
    border-color: #ff5f5f; 
    border-radius: 10px; 
    color: #ff5f5f; 
    font-size: 32px; 
    padding: 15px 30px; 
    -unity-font-style: bold; 
    align-self: center; 
    transition-duration: 0.2s;
    margin-top: 20px; 
}

.botao-reset:hover { 
    background-color: #ff5f5f; 
    color: white; 
}

.linha-controle {
    flex-direction: row;
    align-items: center;
    justify-content: space-between; 
    margin-bottom: 25px;
    width: 100%; 
    padding-right: 40px;
    border-bottom-width: 1px; 
    border-color: rgba(255, 255, 255, 0.05);
    padding-bottom: 15px;
}

.tecla-wrapper-direita {
    flex-grow: 1;
    flex-direction: row;       
    align-items: center;       
}

.tecla-container {
    width: 100px; 
    height: 100px;
    min-width: 100px;
    min-height: 100px; 
    max-width: 100px;  
    max-height: 100px;
    padding: 0; 
    flex-shrink: 0; 
    margin-left: auto; 
    margin-right: 0;
    -unity-background-scale-mode: scale-to-fit; 
}

.tecla-container-larga {
    width: 250px; 
    height: 150px;
    min-width: 250px;
    min-height: 150px;
    max-width: 250px;
    max-height: 150px;
    padding: 0; 
    flex-shrink: 0;
    margin-left: auto; 
    margin-right: 0;
    -unity-background-scale-mode: scale-to-fit; 
}

.cor-master { 
    background-color: #32CD32; 
} 
.cor-sfx { 
    background-color: #00BFFF; 
}    
.cor-musica { 
    background-color: #FFD700; 
} 

.ancora-fundo {
    margin-top: auto;
}