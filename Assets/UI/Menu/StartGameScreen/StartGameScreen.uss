.tela-inteira {
    flex-grow: 1;
    align-items: center;
    justify-content: center; 
    background-color: transparent; 
}

.titulo-container {
    position: relative;
    align-self: center; 
}

.titulo-fundo {
    font-size: 200px; 
    color: #444444; 
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
    white-space: nowrap;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgba(0, 0, 0, 1);
    text-shadow: 8px 8px 0px rgba(0, 0, 0, 0.8);
}

.mascara {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 0%; 
    overflow: hidden; 
}

.titulo-frente {
    font-size: 200px; 
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
    white-space: nowrap; 
    position: absolute;
    top: 0;
    left: 0;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgba(0, 0, 0, 1);
}

.prompt-text {
    font-size: 80px;
    color: #DDDDDD;
    margin-top: 80px; 
    letter-spacing: 5px;
    -unity-font-style: bold;
    -unity-text-outline-width: 3px; 
    -unity-text-outline-color: rgba(0, 0, 0, 1);
    text-shadow: 4px 4px 0px rgba(0, 0, 0, 0.8); 
}