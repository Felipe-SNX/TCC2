.tela-inteira {
    flex-grow: 1;
    padding: 60px;
    justify-content: flex-start; 
    background-color: rgba(0, 0, 0, 0.8);
}

.titulo-tela {
    font-size: 70px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 40px;
    text-shadow: 3px 3px 0px rgba(0, 0, 0, 0.6);
}

.layout-duas-colunas {
    flex-direction: row; 
    flex-grow: 1;        
}

.sidebar {
    width: 500px;
    margin-right: 40px; 
}

.botao-menu {
    font-size: 40px;
    color: black;
    background-color: #FDF9EB;
    padding: 15px 20px;
    margin-bottom: 25px;
    border-radius: 8px;
    border-left-width: 8px;
    border-bottom-width: 6px;
    border-top-width: 0;
    border-right-width: 0;
    border-color: #D6D0B9;
    -unity-font-style: bold;
    transition-duration: 0.15s;
}

.botao-menu:hover {
    background-color: #FFFFFF;
    translate: 10px 0;
}

.botao-ativo {
    background-color: #FFD700; 
    border-color: #B89C00;
    translate: 15px 0; 
}

.botao-menu.botao-ativo {
    background-color: #FFD700; 
    border-color: #B89C00;
    translate: 15px 0; 
}

.botao-menu.botao-ativo:hover {
    background-color: #FFEA70; 
}

.painel-conteudo {
    flex-grow: 1; 
    background-color: rgba(30, 50, 90, 0.85); 
    border-radius: 12px;
    padding: 50px;
}

.titulo-aba {
    font-size: 60px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 40px;
}

.linha-slider {
    flex-direction: row; 
    align-items: center; 
    margin-bottom: 40px;
}

.label-slider {
    font-size: 35px; 
    color: white;
    -unity-font-style: bold;
    width: 300px; 
}

.meu-slider {
    width: 350px;
}

.valor-slider {
    font-size: 35px;
    color: #FFD700; 
    -unity-font-style: bold;
    margin-left: 20px; 
    width: 80px;
}

.label-controles {
    font-size: 40px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 20px;
}